using Gtk 4.0;

template $PebblesCalculusDisplay: $PebblesDisplay {
    CenterBox lcd_status_bar {
        layout {
            row: 0;
            column: 0;
        }

        hexpand: true;
        margin-end: 8;

        styles [
            "status-bar"
        ]

        start-widget: Box {
            orientation: horizontal;
            spacing: 8;

            Label deg_label {
                label: "DEG";
                opacity: 1;
            }

            Label rad_label {
                label: "RAD";
                opacity: 0.2;
            }

            Label grad_label {
                label: "GRAD";
                opacity: 0.2;
            }
        };

        center-widget: Box {
            orientation: horizontal;
            spacing: 8;

            Label memory_label {
                label: "M";
                opacity: 0.2;
            }

            Label global_memory_label {
                label: "GM";
                opacity: 0.2;
            }
        };

        end-widget: Label shift_label {
            label: _("SHIFT");
            opacity: 0.2;
        };
    }

    ScrolledWindow viewport {
        propagate-natural-height: false;
        vexpand: true;
        min-content-height: 100;

        layout {
          column: 0;
          row: 1;
        }

        Box {
            orientation: vertical;
            spacing: 4;
            valign: end;
            margin-end: 8;

            $PebblesHistoryDisplay history_display {
                context: bind template.context;
                viewport: viewport;

                inserted => $insert_from_history();
                recalled => $recall_history();
            }

            Label main_label {
                styles [
                    "lcd-label"
                ]

                halign: end;
                vexpand: true;
                label: "0";
            }
        }
    }

    Separator {
        orientation: horizontal;
        margin-top: 4;
        margin-bottom: 6;
        margin-end: 8;
        valign: center;

        layout {
          column: 0;
          row: 2;
        }

        styles ["lcd-seperator"]
    }

    Box {
        orientation: horizontal;

        layout {
            column: 0;
            row: 3;
        }

        Entry main_entry {
            halign: fill;
            hexpand: true;
            margin-bottom: 9;
            margin-end: 8;
            xalign: 1;
            width-request: 80;
            text: "0";
            styles ["lcd-entry"]

            activate => $input();
        }

        Entry limit_entry_a {
            width-request: 10;
            primary-icon-name: "integral-limit-lower-symbolic";
            primary-icon-tooltip-text: _("Integral lower limit");
            visible: bind template.integral_mode;
            placeholder-text: _("Lower limit");
            styles ["data-table-cell"]

            changed => $set_limit_a();
        }

        Entry limit_entry_b {
            width-request: 10;
            primary-icon-name: "integral-limit-upper-symbolic";
            primary-icon-tooltip-text: _("Integral upper limit");
            visible: bind template.integral_mode;
            placeholder-text: _("Upper limit");
            margin-end: 8;
            styles ["data-table-cell"]

            changed => $set_limit_b();
        }

        Entry limit_entry_der {
            width-request: 10;
            primary-icon-name: "derivative-limit-symbolic";
            primary-icon-tooltip-text: _("x tends to");
            visible: bind template.integral_mode inverted;
            placeholder-text: _("when value of x is");
            margin-end: 8;
            styles ["data-table-cell"]

            changed => $set_limit_x();
        }
    }


}
