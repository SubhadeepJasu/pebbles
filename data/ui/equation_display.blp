using Gtk 4.0;

template $PebblesEquationDisplay: $PebblesDisplay {
    CenterBox lcd_status_bar {
        layout {
            row: 0;
            column: 0;
        }

        hexpand: true;
        margin-end: 8;

        styles [
            "status-bar"
        ]

        start-widget: Box {
            orientation: horizontal;
            spacing: 8;

            Label deg_label {
                label: "DEG";
                opacity: 1;
            }

            Label rad_label {
                label: "RAD";
                opacity: 0.2;
            }

            Label grad_label {
                label: "GRAD";
                opacity: 0.2;
            }
        };

        center-widget: Box {
            orientation: horizontal;
            spacing: 8;

            Label global_memory_label {
                label: "GM";
                opacity: 0.2;
            }

            Label shift_label {
                label: _("SHIFT");
                opacity: 0.2;
            }
        };

        end-widget: Label eq_label {
            label: bind template.eq_label;
        };
    }

    ScrolledWindow {
        propagate-natural-height: false;
        has-frame: false;
        hexpand: true;
        vexpand: true;
        margin-bottom: 8;

        layout {
            row: 1;
            column: 0;
        }

        Box eq_box {
            orientation: vertical;
            spacing: 4;
            valign: start;
            margin-end: 8;
        }
    }
}
