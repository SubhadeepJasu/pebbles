using Gtk 4.0;
using Adw 1;

template $PebblesProgrammerView: $PebblesView {
  $PebblesProgrammerDisplay display {
    context: bind template.context;
    collapsed: bind template.collapsed;

    layout {
      column: 0;
      row: 0;
    }

    vexpand: true;
    shift_on: bind shift_button.active;
    last_token_changed => $last_bits_changed();
  }

  Stack programmer_stack {
    transition-type: over_up_down;

    layout {
      column: 0;
      row: 1;
    }

    Adw.NavigationSplitView prog_nav_split_view {
      vexpand: true;
      height-request: 250;
      sidebar-width-fraction: 0.5;
      max-sidebar-width: 1000000;
      min-sidebar-width: 256;
      margin-start: 7;
      margin-end: 7;
      margin-bottom: 7;
      collapsed: bind template.collapsed;

      sidebar: Adw.NavigationPage button_container_left {
        title: "Numerical Input";
        hexpand: true;
        overflow: visible;

        Grid {
          row-homogeneous: true;
          column-homogeneous: true;
          row-spacing: 8;
          column-spacing: 8;
          vexpand: true;
          hexpand: true;
          margin-start: 6;
          margin-end: 6;
          margin-bottom: 6;
          margin-top: 1;

          $PebblesButton all_clear_button {
            label_text: _("AC");
            tooltip_desc: _("All Clear");
            accel_markup: bind template.all_clear_key;
            focus-on-click: false;
            key: bind template.all_clear_key;

            styles [
              "destructive-action",
              "adaptive-btn-font"
            ]

            layout {
              row: 0;
              column: 0;
            }

            clicked => $on_all_clear();
          }

          $PebblesButton del_button {
            icon: "edit-clear-symbolic";
            tooltip_desc: _("Backspace");
            focus-on-click: false;
            key: "BackSpace";

            layout {
              row: 0;
              column: 1;
            }

            clicked => $on_backspace();
          }

          $PebblesButton lsh_rsh_button {
            name: "l";
            label_text: "Lsh";
            tooltip_desc: _("Left Shift");
            accel_markup: "L";
            key: "l,L";
            focus-on-click: false;

            layout {
              row: 0;
              column: 2;
            }

            styles [
              "adaptive-btn-font"
            ]

            clicked => $on_click_function();
          }

          $PebblesButton divide_button {
            label_text: "÷";
            tooltip_desc: _("Divide");
            focus-on-click: false;
            key: "/";

            layout {
              row: 0;
              column: 3;
            }

            styles [
              "adaptive-btn-font",
              "large-font-btn"
            ]

            clicked => $on_click_div_button();
          }

          $PebblesButton fx_button {
            label_text: "← <i>f(x)</i>";
            visible: bind template.collapsed;
            focus-on-click: false;

            styles [
              "special-action",
              "adaptive-btn-font"
            ]

            layout {
              row: 0;
              column: 4;
            }

            clicked => $on_expand_fx();
          }

          $PebblesButton seven_button {
            name: "7";
            label_text: "7";
            focus-on-click: false;
            key: "7";

            styles [
              "adaptive-btn-font"
            ]

            layout {
              row: 1;
              column: 0;
            }

            clicked => $on_click_button();
          }

          $PebblesButton eight_button {
            name: "8";
            label_text: "8";
            focus-on-click: false;
            key: "8";

            styles [
              "adaptive-btn-font"
            ]

            layout {
              row: 1;
              column: 1;
            }

            clicked => $on_click_button();
          }

          $PebblesButton nine_button {
            name: "9";
            label_text: "9";
            focus-on-click: false;
            key: "9";

            styles ["adaptive-btn-font"]

            layout {
              row: 1;
              column: 2;
            }

            clicked => $on_click_button();
          }

          $PebblesButton multiply_button {
            label_text: "×";
            tooltip_desc: _("Multiply");
            focus-on-click: false;
            key: "*";

            styles [
              "adaptive-btn-font",
              "large-font-btn"
            ]

            layout {
              row: 1;
              column: 3;
            }

            clicked => $on_click_mul_button();
          }

          $PebblesButton or_button_p {
            name: "o";
            label_text: "Or";
            tooltip_desc: _("Bitwise OR (TRUE for any input being TRUE)");
            accel_markup: "O";
            visible: bind template.collapsed;
            focus-on-click: false;
            key: "o";

            styles [
              "special-action",
              "adaptive-btn-font"
            ]

            layout {
              row: 1;
              column: 4;
            }

            clicked => $on_click_function();
          }

          $PebblesButton four_button {
            name: "4";
            label_text: "4";
            focus-on-click: false;
            key: "4";

            styles ["adaptive-btn-font"]

            layout {
              row: 2;
              column: 0;
            }

            clicked => $on_click_button();
          }

          $PebblesButton five_button {
            name: "5";
            label_text: "5";
            focus-on-click: false;
            key: "5";

            styles ["adaptive-btn-font"]

            layout {
              row: 2;
              column: 1;
            }

            clicked => $on_click_button();
          }

          $PebblesButton six_button {
            name: "6";
            label_text: "6";
            focus-on-click: false;
            key: "6";

            styles ["adaptive-btn-font"]

            layout {
              row: 2;
              column: 2;
            }

            clicked => $on_click_button();
          }

          $PebblesButton subtract_button {
            label_text: "−";
            tooltip_desc: _("Subtract");
            focus-on-click: false;
            key: "-";

            styles [
              "adaptive-btn-font",
              "large-font-btn"
            ]

            layout {
              row: 2;
              column: 3;
            }

            clicked => $on_click_sub_button();
          }

          $PebblesButton and_button_p {
            name: "n";
            label_text: "And";
            tooltip_desc: _("Bitwise AND (TRUE for all inputs being TRUE)");
            accel_markup: "N";
            visible: bind template.collapsed;
            focus-on-click: false;
            key: "n";

            styles [
              "special-action",
              "adaptive-btn-font"
            ]

            layout {
              row: 2;
              column: 4;
            }

            clicked => $on_click_function();
          }

          $PebblesButton one_button {
            name: "1";
            label_text: "1";
            focus-on-click: false;
            key: "1";

            styles ["adaptive-btn-font"]

            layout {
              row: 3;
              column: 0;
            }

            clicked => $on_click_button();
          }

          $PebblesButton two_button {
            name: "2";
            label_text: "2";
            focus-on-click: false;
            key: "2";

            styles ["adaptive-btn-font"]

            layout {
              row: 3;
              column: 1;
            }

            clicked => $on_click_button();
          }

          $PebblesButton three_button {
            name: "3";
            label_text: "3";
            focus-on-click: false;
            key: "3";

            styles ["adaptive-btn-font"]

            layout {
              row: 3;
              column: 2;
            }

            clicked => $on_click_button();
          }

          $PebblesButton addition_button {
            label_text: "+";
            tooltip_desc: _("Add");
            focus-on-click: false;
            key: "+";

            styles [
              "adaptive-btn-font",
              "large-font-btn"
            ]

            layout {
              row: 3;
              column: 3;
            }

            clicked => $on_click_add_button();
          }

          $PebblesButton xor_button_p {
            name: "t";
            label_text: "Xor";
            tooltip_desc: _("Bitwise XOR (TRUE only when inputs are different)");
            accel_markup: "T";
            visible: bind template.collapsed;
            focus-on-click: false;
            key: "t";

            styles [
              "special-action",
              "adaptive-btn-font"
            ]

            layout {
              row: 3;
              column: 4;
            }

            clicked => $on_click_function();
          }

          $PebblesButton zero_button {
            name: "0";
            label_text: "0";
            styles ["adaptive-btn-font"]
            focus-on-click: false;
            key: "0";

            layout {
              row: 4;
              column: 0;
            }

            clicked => $on_click_button();
          }

          $PebblesButton paren_start_button {
            name: "(";
            label_text: "(";
            styles ["adaptive-btn-font"]
            focus-on-click: false;
            key: "(, {, [";

            layout {
              row: 4;
              column: 1;
            }

            clicked => $on_click_button();
          }

          $PebblesButton paren_end_button {
            name: ")";
            label_text: ")";
            styles ["adaptive-btn-font"]
            focus-on-click: false;
            key: "), }, ]";

            layout {
              row: 4;
              column: 2;
            }

            clicked => $on_click_button();
          }

          $PebblesButton not_button {
            name: "t";
            label_text: "Not";
            tooltip_desc: _("Bitwise NOT (TRUE for input being FALSE and Vice Versa)");
            accel_markup: "T";
            focus-on-click: false;
            key: "t";

            styles [
              "special-action",
              "adaptive-btn-font"
            ]

            layout {
              row: 4;
              column: 3;
            }

            clicked => $on_click_function();
          }

          $PebblesButton result_button_p {
            label_text: _("=");
            tooltip_desc: _("Result");
            accel_markup: "Return";
            visible: bind template.collapsed;
            focus-on-click: false;
            key: "=, Return";

            styles [
              "suggested-action",
              "large-font-btn",
              "adaptive-btn-font"
            ]

            layout {
              row: 4;
              column: 4;
            }

            clicked => $on_click_eval();
          }
        }
      };

      content: Adw.NavigationPage button_container_right {
        title: "Functional Input";
        hexpand: true;
        overflow: visible;

        Grid {
          row-homogeneous: true;
          column-homogeneous: true;
          row-spacing: 8;
          column-spacing: 8;
          vexpand: true;
          hexpand: true;
          margin-start: 6;
          margin-end: 6;
          margin-bottom: 6;
          margin-top: 2;

          Box {
            homogeneous: true;
            styles ["linked"]

            layout {
              row: 0;
              column: 0;
              column-span: 4;
            }

            ToggleButton hex_toggle {
              name: "hex-toggle";
              label: "HEXA";
              can-focus: false;

              toggled => $on_number_system_toggle();
            }

            ToggleButton dec_toggle {
              name: "dec-toggle";
              label: "DECI";
              group: hex_toggle;
              can-focus: false;

              toggled => $on_number_system_toggle();
            }

            ToggleButton oct_toggle {
              name: "oct-toggle";
              label: "OCTL";
              group: hex_toggle;
              can-focus: false;

              toggled => $on_number_system_toggle();
            }

            ToggleButton bin_toggle {
              name: "bin-toggle";
              label: "BNRY";
              group: hex_toggle;
              can-focus: false;

              toggled => $on_number_system_toggle();
            }
          }

          $PebblesButton memory_plus_button {
            label_text: "M+";
            tooltip_desc: _("Add it to the value in Memory");
            accel_markup: "F3";
            focus-on-click: false;
            key: "F3";

            styles [
              "memory-action",
              "adaptive-btn-font"
            ]

            layout {
              row: 1;
              column: 3;
            }

            clicked => $on_click_memory_add();
          }

          $PebblesButton hex_e_button {
            name: "e";
            label_text: "E";
            focus-on-click: false;
            key: "e,E";

            styles [
              "adaptive-btn-font"
            ]

            layout {
              row: 1;
              column: 0;
            }

            clicked => $on_click_button();
          }

          $PebblesButton hex_f_button {
            name: "f";
            label_text: "F";
            focus-on-click: false;
            key: "f,F";

            styles [
              "adaptive-btn-font"
            ]

            layout {
              row: 1;
              column: 1;
            }

            clicked => $on_click_button();
          }

          $PebblesButton or_button {
            name: "o";
            label_text: "Or";
            tooltip_desc: _("Bitwise OR (TRUE for any input being TRUE)");
            accel_markup: "O";
            focus-on-click: false;
            key: "o";

            styles [
              "special-action",
              "adaptive-btn-font"
            ]

            layout {
              row: 1;
              column: 2;
            }

            clicked => $on_click_function();
          }

          $PebblesButton memory_minus_button {
            label_text: _("M−");
            tooltip_desc: _("Subtract it from the value in Memory");
            accel_markup: "F4";
            focus-on-click: false;
            key: "F4";

            styles [
              "memory-action",
              "adaptive-btn-font"
            ]

            layout {
              row: 2;
              column: 3;
            }

            clicked => $on_click_memory_subtract();
          }

          $PebblesButton hex_c_button {
            name: "c";
            label_text: "C";
            focus-on-click: false;
            key: "c,C";

            styles [
              "adaptive-btn-font"
            ]

            layout {
              row: 2;
              column: 0;
            }

            clicked => $on_click_button();
          }

          $PebblesButton hex_d_button {
            name: "d";
            label_text: "D";
            focus-on-click: false;
            key: "d,D";

            styles [
              "adaptive-btn-font"
            ]

            layout {
              row: 2;
              column: 1;
            }

            clicked => $on_click_button();
          }

          $PebblesButton and_button {
            name: "n";
            label_text: "And";
            tooltip_desc: _("Bitwise AND (TRUE for all inputs being TRUE)");
            accel_markup: "N";
            focus-on-click: false;
            key: "n";

            styles [
              "special-action",
              "adaptive-btn-font"
            ]

            layout {
              row: 2;
              column: 2;
            }

            clicked => $on_click_function();
          }

          $PebblesButton memory_recall_button {
            label_text: _("MR");
            tooltip_desc: _("Recall value from Memory");
            accel_markup: "F5";
            focus-on-click: false;
            key: "F5";

            styles [
              "memory-action",
              "adaptive-btn-font"
            ]

            layout {
              row: 3;
              column: 3;
            }

            clicked => $on_click_memory_recall();
          }

          $PebblesButton hex_a_button {
            name: "a";
            label_text: "A";
            focus-on-click: false;
            key: "t,T";

            styles [
              "adaptive-btn-font"
            ]

            layout {
              row: 3;
              column: 0;
            }

            clicked => $on_click_button();
          }

          $PebblesButton hex_b_button {
            name: "b";
            label_text: "B";
            focus-on-click: false;
            key: "b,B";

            styles [
              "adaptive-btn-font"
            ]

            layout {
              row: 3;
              column: 1;
            }

            clicked => $on_click_button();
          }

          $PebblesButton xor_button {
            name: "t";
            label_text: "Xor";
            tooltip_desc: _("Bitwise XOR (TRUE only when inputs are different)");
            accel_markup: "T";
            focus-on-click: false;
            key: "t";

            styles [
              "special-action",
              "adaptive-btn-font"
            ]

            layout {
              row: 3;
              column: 2;
            }

            clicked => $on_click_function();
          }

          $PebblesButton memory_clear_button {
            label_text: _("MC");
            tooltip_desc: _("Memory Clear");
            accel_markup: "F6";
            focus-on-click: false;
            key: "F6";

            styles [
              "memory-action",
              "adaptive-btn-font"
            ]

            layout {
              row: 4;
              column: 3;
            }

            clicked => $on_click_memory_clear();
          }

          ToggleButton shift_button {
            label: _("Shift");
            focus-on-click: false;

            styles [
              "special-action",
              "adaptive-btn-font"
            ]

            layout {
              row: 4;
              column: 0;
            }

            clicked => $on_shift();
          }

          $PebblesButton last_answer_button {
            label_text: "Ans";
            tooltip_desc: _("Insert last answer");
            accel_markup: "F7";
            focus-on-click: false;
            key: "F7";

            styles [
              "special-action",
              "adaptive-btn-font"
            ]

            layout {
              row: 4;
              column: 1;
            }

            clicked => $on_click_last_ans();
          }

          $PebblesButton result_button {
            label_text: _("=");
            tooltip_desc: _("Result");
            accel_markup: "Return";
            visible: bind template.collapsed inverted;
            focus-on-click: false;
            key: "Return";

            styles [
              "suggested-action",
              "large-font-btn",
              "adaptive-btn-font"
            ]

            layout {
              row: 4;
              column: 2;
            }

            clicked => $on_click_eval();
          }

          $PebblesButton collapse_fx_button {
            label_text: _("->");
            visible: bind prog_nav_split_view.collapsed;
            focus-on-click: false;

            styles [
              "suggested-action",
              "large-font-btn",
              "adaptive-btn-font"
            ]

            layout {
              row: 4;
              column: 2;
            }

            clicked => $on_collapse_fx();
          }
        }
      };
    }

    $PebblesBitGrid bit_grid {
      hide_grid => $on_hide_bit_grid();
      changed => $set_bits_from_grid();
    }
  }
}
